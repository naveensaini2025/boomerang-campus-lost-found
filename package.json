{
  "name": "boomerang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Boomerang - Campus Lost & Found Portal",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "nodemon server/index.js",
    "server:start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run server:start",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node server/seed.js",
    "reset-db": "node -e \"require('fs').unlinkSync('data/boomerang.db');require('fs').unlinkSync('data/boomerang.db-shm');require('fs').unlinkSync('data/boomerang.db-wal')\" && node initdb.mjs && node makeadmin.mjs && node server/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
